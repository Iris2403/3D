{
  "name": "kuki-theme",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "templates": "python3 scripts/gen-templates.py",
    "build:css": "esbuild src/styles/kuki.css --minify --outfile=theme/assets/kuki.css --log-level=warning",
    "build:js": "node scripts/clean-chunks.mjs && vite build",
    "build": "npm run build:css && npm run build:js",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "node preview/server.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "check": "npm run typecheck && npm run build && npm audit --omit=optional"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@types/three": "^0.170.0",
    "axe-core": "^4.14.0",
    "liquidjs": "^10.30.1",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5",
    "three": "^0.170.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "private": true,
  "type": "module"
}
