<section class="page-hero" aria-labelledby="page-title">
  <div class="container">
    <p class="eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
    <h1 class="page-hero__title" id="page-title" data-split style="margin-top: 1rem">{% render 'kuki-split-text', text: section.settings.title %}</h1>
    {%- if section.settings.text != blank -%}<p class="lede" style="margin-top: 1.25rem" data-reveal>{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.settings.show_order -%}
      <div class="btn-row" style="margin-top: 1.75rem" data-reveal>
        <a class="btn btn--caramel" href="{{ settings.order_url }}" target="_blank" rel="noopener" data-magnetic>{{ settings.order_label | escape }} {% render 'kuki-icon', name: 'arrow-up-right', class: 'btn__icon' %}<span class="visually-hidden">({{ 'general.opens_new_window' | t }})</span></a>
      </div>
    {%- endif -%}
  </div>
  {%- if section.settings.asset != blank -%}{%- render 'kuki-picture', name: section.settings.asset, alt: '', class: 'page-hero__mascot', sizes: '220px' -%}{%- endif -%}
</section>
{% schema %}
{
  "name": "Page header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Title (wrap words in *asterisks* for italics)" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_order", "label": "Show order button", "default": false },
    { "type": "text", "id": "asset", "label": "Illustration (developer)" }
  ],
  "presets": [{ "name": "Page header" }]
}
{% endschema %}
