<div class="marquee-wrap" aria-hidden="true"><div class="marquee" style="--marquee-dur: {{ section.settings.speed }}s">
  <div class="marquee__track">
    {%- for i in (1..2) -%}
      <div class="marquee__group">
        {%- for block in section.blocks -%}<span class="marquee__item">{{ block.settings.text | escape }}</span>{%- endfor -%}
        {%- for block in section.blocks -%}<span class="marquee__item">{{ block.settings.text | escape }}</span>{%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div></div>
{% schema %}
{
  "name": "Marquee",
  "settings": [{ "type": "range", "id": "speed", "label": "Duration (s)", "min": 20, "max": 80, "step": 2, "default": 40 }],
  "blocks": [{ "type": "item", "name": "Item", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Baked fresh daily" }] }],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}
