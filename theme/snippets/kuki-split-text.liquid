{%- comment -%}
  Splits a heading into word spans for the staggered reveal. Text stays a normal, readable string for
  screen readers and crawlers (spans add no semantics). Words wrapped in *asterisks* become <em>.
{%- endcomment -%}
{%- assign words = text | split: ' ' -%}
{%- for word in words -%}
  {%- assign w = word | escape -%}
  {%- if w contains '*' -%}
    {%- assign w = w | remove: '*' -%}
    <span class="w"><span style="--i: {{ forloop.index0 }}"><em>{{ w }}</em></span></span>
  {%- else -%}
    <span class="w"><span style="--i: {{ forloop.index0 }}">{{ w }}</span></span>
  {%- endif -%}
  {%- unless forloop.last %} {% endunless -%}
{%- endfor -%}
