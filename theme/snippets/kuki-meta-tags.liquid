{%- liquid
  assign title = page_title | default: shop.name
  if template.name == 'index'
    assign title = settings.seo_home_title | default: shop.name
  elsif current_tags
    assign title = title | append: ' – ' | append: current_tags | join: ', '
  endif
  unless template.name == 'index' or title contains shop.name
    assign title = title | append: ' | ' | append: shop.name
  endunless
  assign description = page_description | default: settings.seo_description | default: shop.description
  if template.suffix == 'menu' and page_description == blank
    assign description = settings.seo_menu_description | default: description
  endif
  assign og_image = settings.share_image
  if og_image != blank
    assign og_image_url = og_image | image_url: width: 1200
  else
    assign og_image_url = 'og-image.jpg' | asset_url
  endif
  assign og_image_url = og_image_url | prepend: 'https:' | replace: 'https:https:', 'https:'
-%}
<title>{{ title | escape }}</title>
{%- if description != blank -%}<meta name="description" content="{{ description | escape }}">{%- endif -%}
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ title | escape }}">
<meta property="og:type" content="website">
{%- if description != blank -%}<meta property="og:description" content="{{ description | escape }}">{%- endif -%}
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="en_GR">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title | escape }}">
{%- if description != blank -%}<meta name="twitter:description" content="{{ description | escape }}">{%- endif -%}
