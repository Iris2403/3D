    "faq": {
      "type": "faq",
      "settings": {
        "contact_text": "Dietary needs, allergies, events or corporate gifts — message us and our team will be happy to help."
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Do you offer vegan or gluten-free options?",
            "answer": "Yes. We offer selected vegan and gluten-free cookie options to accommodate different dietary preferences. Availability may vary depending on the season and product range. If you have specific dietary requirements or allergies, please contact us before placing your order and our team will be happy to assist."
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How long do cookies stay fresh?",
            "answer": "Our cookies are baked fresh daily for the best taste and texture. We recommend enjoying them within 3–5 days of purchase when stored in an airtight container at room temperature. For longer storage, cookies can be frozen and enjoyed later."
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Can I order cookies for events or corporate gifts?",
            "answer": "Absolutely. KUKI Athens offers custom cookie orders for corporate events, business gifts, celebrations, weddings, birthdays, and special occasions. We can accommodate larger quantities and discuss customized packaging or branding options depending on your requirements."
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
        "question_3"
