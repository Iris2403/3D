    "story": {
      "type": "story",
      "settings": {
        "title": "Baked with *Love,* Served with *Joy*",
        "text": "At KUKI, every cookie is handcrafted to turn a simple break into something worth craving. Made with rich butter, premium chocolate, handmade fillings, and a touch of fleur de sel, each bite is soft, bold, and full of comfort."
      },
      "blocks": {
        "pillar_1": {
          "type": "pillar",
          "settings": {
            "title": "Premium Ingredients",
            "text": "Selected butter, quality chocolate, and carefully sourced ingredients in every recipe."
          }
        },
        "pillar_2": {
          "type": "pillar",
          "settings": {
            "title": "Expert Craft",
            "text": "Handcrafted cookies made with precision, technique, and attention to every detail."
          }
        },
        "pillar_3": {
          "type": "pillar",
          "settings": {
            "title": "Quality First",
            "text": "Every recipe is designed to deliver consistency, balance, and a premium taste experience."
          }
        },
        "pillar_4": {
          "type": "pillar",
          "settings": {
            "title": "Baked Daily",
            "text": "Prepared daily to ensure maximum freshness, softness, and flavor in every bite."
          }
        }
      },
      "block_order": [
        "pillar_1",
        "pillar_2",
        "pillar_3",
        "pillar_4"
      ]
    },
